# SnapFoley env (copy to backend/.env and frontend/.env.local as needed)
# Backend (FastAPI) — server-side only, never expose in frontend
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ELEVENLABS_API_KEY=

# Frontend (Next.js) — only non-secret URLs
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
